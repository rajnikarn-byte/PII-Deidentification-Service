# Set these in your environment, or copy to .env and run `npm run start:env`
# (uses Node's built-in --env-file). All values are optional; defaults shown.
PORT=3000
HOST=0.0.0.0
# Max JSON body size: <n>b | <n>kb | <n>mb (max 10mb). Invalid values fail startup.
BODY_LIMIT=256kb
# Max length of the "text" field, in UTF-16 code units.
MAX_TEXT_LENGTH=100000
# Per-client rate limit for POST /deidentify. RATE_LIMIT_MAX=0 disables it.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# Express "trust proxy": false | true | <hop count> | <subnet list>. Only enable behind a proxy you control.
TRUST_PROXY=false
# debug | info | warn | error | silent
LOG_LEVEL=info
